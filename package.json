{
  "name": "better",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.7.7",
      "evlog": "^2.28.1",
      "@orpc/client": "^1.15.0",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @better/db --",
    "db:studio": "turbo run db:studio -F @better/db --",
    "db:generate": "turbo run db:generate -F @better/db --",
    "db:migrate": "turbo run db:migrate -F @better/db --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "check": "biome check --write ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better/config": "workspace:*",
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
