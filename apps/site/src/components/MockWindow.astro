---
import Lock from "@lucide/astro/icons/lock"
import Logo from "@/components/Logo.astro"

interface Props {
  /** `app` is a Garabato page; `site` is any other website. */
  kind: "app" | "site"
  /** The route after garabato.example.com, or the website's address. */
  address: string
  class?: string
}

const { kind, address, class: className } = Astro.props
---

<!-- A drawn browser window around a mock screen of the browser token
     walkthrough. The Garabato bar matches AppFrame; other sites get a light
     address bar, so the two read as different places. -->
<div
  class:list={[
    "overflow-hidden rounded-frame border shadow-[0_18px_40px_-24px_rgb(0_0_0/0.35)]",
    kind === "app" ? "border-terminal-border" : "border-border",
    className,
  ]}
>
  {kind === "app" ? (
    <div class="terminal-bar h-8 gap-2.5 px-3">
      <Logo class="size-3.5 text-primary" />
      <span class="truncate font-mono text-[0.6875rem] text-terminal-muted">
        garabato.example.com<span class="text-terminal-fg">{address}</span>
      </span>
    </div>
  ) : (
    <div class="flex h-8 items-center gap-3 border-b border-border bg-card px-3">
      <span class="flex gap-1.5">
        <span class="size-2 rounded-full bg-border" />
        <span class="size-2 rounded-full bg-border" />
        <span class="size-2 rounded-full bg-border" />
      </span>
      <span class="flex min-w-0 flex-1 items-center gap-1.5 rounded-md bg-background px-2.5 py-0.5 font-mono text-[0.6875rem] text-muted-foreground">
        <Lock class="size-3 shrink-0" stroke-width={2} />
        <span class="truncate">{address}</span>
      </span>
    </div>
  )}
  <div class="grid bg-background">
    <slot />
  </div>
</div>
