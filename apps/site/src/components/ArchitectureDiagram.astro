---
import { type Lang, t } from "@/i18n/ui"

interface Props {
  lang: Lang
  class?: string
}

const { lang, class: className } = Astro.props
const dict = t(lang)
const n = dict.arch.nodes
const r = dict.arch.roles

// Topology of the Docker Compose stack (compose.prod.yml), drawn with the
// site tokens so it follows the theme. Coordinates are in the 1200×470 space
// (the viewBox crops the empty top 40); every box is 76 high and labelled from
// its centre.
interface Box {
  x: number
  y: number
  w: number
  name: string
  port?: string
  role?: string
}

const boxes: Box[] = [
  { x: 20, y: 210, w: 170, name: n.browser },
  { x: 640, y: 60, w: 240, name: n.frontend, port: ":4321", role: r.frontend },
  { x: 640, y: 232, w: 240, name: n.backend, port: ":3000", role: r.backend },
  { x: 960, y: 140, w: 220, name: n.postgres, port: ":5432", role: r.postgres },
  { x: 960, y: 290, w: 220, name: n.storage, port: ":9000", role: r.storage },
  { x: 640, y: 390, w: 240, name: n.loki, port: ":3100", role: r.loki },
]

interface Edge {
  d: string
  /** Optional service: drawn dashed. */
  optional?: boolean
  label: string
  lx: number
  ly: number
  anchor?: "start" | "middle" | "end"
}

const edges: Edge[] = [
  { d: "M190,248 H274", label: "HTTPS", lx: 232, ly: 238 },
  {
    d: "M510,256 H530 V98 H634",
    label: "/*",
    lx: 540,
    ly: 180,
    anchor: "start",
  },
  { d: "M510,282 H634", label: "/rpc /api", lx: 572, ly: 272 },
  {
    d: "M880,256 H920 V178 H954",
    label: "SQL",
    lx: 928,
    ly: 222,
    anchor: "start",
  },
  {
    d: "M880,286 H920 V328 H954",
    label: "S3",
    lx: 928,
    ly: 312,
    anchor: "start",
  },
  {
    d: "M760,308 V384",
    optional: true,
    label: "HTTP",
    lx: 770,
    ly: 350,
    anchor: "start",
  },
]
---

<svg
  viewBox="0 40 1200 430"
  role="img"
  aria-labelledby="arch-diagram-title arch-diagram-desc"
  class:list={["h-auto w-full", className]}
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="arch-diagram-title">{dict.arch.diagramTitle}</title>
  <desc id="arch-diagram-desc">{dict.arch.diagramDesc}</desc>
  <defs>
    <marker
      id="arch-arrow"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" class="fill-muted-foreground"></path>
    </marker>
  </defs>

  <g class="fill-none stroke-muted-foreground" stroke-width="1.25">
    {edges.map((edge) => (
      <path
        d={edge.d}
        marker-end="url(#arch-arrow)"
        stroke-dasharray={edge.optional ? "5 4" : undefined}
      />
    ))}
  </g>

  <g class="font-mono text-[12px] fill-muted-foreground arch-halo">
    {edges.map((edge) => (
      <text x={edge.lx} y={edge.ly} text-anchor={edge.anchor ?? "middle"}>
        {edge.label}
      </text>
    ))}
  </g>

  <!-- Gateway: the only published port. -->
  <g>
    <rect
      x="280"
      y="180"
      width="230"
      height="136"
      rx="8"
      class="fill-card stroke-border"
    ></rect>
    <text x="298" y="210" class="font-sans text-[16px] font-medium fill-strong">
      {n.gateway}
    </text>
    <text x="298" y="230" class="font-mono text-[12px] fill-muted-foreground">
      Caddy
    </text>
    <line x1="280" x2="510" y1="244" y2="244" class="stroke-border"></line>
    <text x="298" y="286" class="font-mono text-[14px] fill-strong">:80</text>
    <text
      x="492"
      y="286"
      text-anchor="end"
      class="font-mono text-[12px] fill-muted-foreground"
    >
      HTTP · {dict.arch.published}
    </text>
  </g>

  {boxes.map((box) => (
    <g>
      <rect
        x={box.x}
        y={box.y}
        width={box.w}
        height="76"
        rx="8"
        class="fill-card stroke-border"
      />
      <text
        x={box.x + 18}
        y={box.role ? box.y + 32 : box.y + 43}
        class="font-sans text-[16px] font-medium fill-strong"
      >
        {box.name}
      </text>
      {box.port && (
        <text
          x={box.x + box.w - 18}
          y={box.y + 32}
          text-anchor="end"
          class="font-mono text-[13px] fill-muted-foreground"
        >
          {box.port}
        </text>
      )}
      {box.role && (
        <text
          x={box.x + 18}
          y={box.y + 54}
          class="font-mono text-[12px] fill-muted-foreground"
        >
          {box.role}
        </text>
      )}
    </g>
  ))}
</svg>
