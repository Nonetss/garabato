---
import MonitorSmartphone from "@lucide/astro/icons/monitor-smartphone"
import ArrowLink from "@/components/ArrowLink.astro"
import { type Lang, t } from "@/i18n/ui"
import { localized } from "@/lib/url"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const dict = t(lang)
---

<section aria-labelledby="browser-token-title" class="section-block">
  <div class="grid gap-x-16 gap-y-12 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-7">
      <h2 id="browser-token-title" class="section-title max-w-[22ch]">
        {dict.browserToken.heading}
      </h2>
      <p class="mt-5 text-lede text-foreground">{dict.browserToken.lede}</p>
      <p
        class="card-box mt-7 flex gap-3 bg-card px-4 py-3.5 text-meta text-foreground"
      >
        <MonitorSmartphone
          class="mt-0.5 size-4 shrink-0 text-strong"
          stroke-width={1.75}
        />
        <span>{dict.browserToken.platforms}</span>
      </p>
      <p class="mt-8 text-body">
        <ArrowLink href={localized(lang, "docs/browser-token/")}>
          {dict.browserToken.docsLink}
        </ArrowLink>
      </p>
    </div>

    <div class="min-w-0 lg:col-span-5">
      <h3 class="text-label-caps text-muted-foreground">
        {dict.browserToken.stepsLabel}
      </h3>
      <ol class="mt-4">
        {dict.browserToken.steps.map((step, index) => (
          <li class="grid grid-cols-[2rem_1fr] border-t border-hairline py-4 text-body text-foreground">
            <span class="font-mono text-meta text-muted-foreground tabular-nums">
              {index + 1}
            </span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
