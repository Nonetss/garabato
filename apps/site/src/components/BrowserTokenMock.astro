---
import Copy from "@lucide/astro/icons/copy"
import FileBadge from "@lucide/astro/icons/file-badge"
import KeyRound from "@lucide/astro/icons/key-round"
import LoaderCircle from "@lucide/astro/icons/loader-circle"
import Lock from "@lucide/astro/icons/lock"
import ShieldAlert from "@lucide/astro/icons/shield-alert"
import Upload from "@lucide/astro/icons/upload"
import MockWindow from "@/components/MockWindow.astro"
import { type BrowserTokenStepId, type Lang, t } from "@/i18n/ui"

interface Props {
  lang: Lang
  scene: BrowserTokenStepId
}

const { lang, scene } = Astro.props
const mock = t(lang).browserToken.mock

const app = mock.app
const command =
  "curl -fsSL 'https://garabato.example.com/api/v1/certificateToken/installScript?code=7KQ4XMPA' | sh"
const layer = "[grid-area:1/1]"
const backdrop = `${layer} flex items-center justify-center bg-black/30 p-3 sm:p-6`
const dialog =
  "w-full overflow-hidden rounded-lg border border-border bg-background shadow-xl"
const dialogButton =
  "rounded-md border border-border px-3 py-1 text-[0.75rem] text-foreground"
const primaryButton =
  "rounded-md bg-primary px-3 py-1 text-[0.75rem] font-medium text-primary-foreground"
const skeleton = "rounded-sm bg-muted"
---

{scene === "open" && (
  <MockWindow kind="app" address="/certificates">
    <div class="p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="text-[0.9375rem] font-semibold text-strong">
          {app.certificates}
        </span>
        <div class="flex gap-2">
          <!-- The pointer (global.css, .click-pointer) glides onto this button
               and presses it, on a loop. -->
          <span class="relative">
            <span class="click-target flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1 text-[0.6875rem] text-foreground">
              <Lock class="size-3" stroke-width={2} />
              {app.connect}
            </span>
            <span class="click-ripple pointer-events-none absolute inset-0 rounded-md ring-2 ring-primary/50" />
            <svg
              class="click-pointer pointer-events-none absolute top-1/2 left-1/2 size-5 drop-shadow-[0_2px_3px_rgb(0_0_0/0.35)]"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path
                d="M3 2 L3 16 L7 12.5 L9.6 18 L12 17 L9.4 11.6 L14.5 11.2 Z"
                fill="#111"
                stroke="#fff"
                stroke-width="1.4"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="flex items-center gap-1.5 rounded-md bg-primary px-2.5 py-1 text-[0.6875rem] font-medium text-primary-foreground">
            <Upload class="size-3" stroke-width={2} />
            {app.import}
          </span>
        </div>
      </div>
      <p class="mt-4 border-b border-border pb-3 text-[0.6875rem] text-muted-foreground">
        <span class="font-medium text-strong tabular-nums">
          {mock.certificates.length}
        </span>{" "}
        {app.usable}
      </p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {mock.certificates.map((certificate) => (
          <li class="rounded-md border border-border p-3">
            <span class="grid size-7 place-items-center rounded-md bg-accent text-primary">
              <FileBadge class="size-3.5" stroke-width={1.75} />
            </span>
            <span class="mt-3 block truncate text-[0.75rem] font-medium text-strong">
              {certificate.name}
            </span>
            <span class="mt-0.5 block text-[0.6875rem] text-muted-foreground">
              {certificate.valid}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </MockWindow>
)}

{scene === "connect" && (
  <MockWindow kind="app" address="/certificates">
    <div class:list={[layer, "p-5"]}>
      <div class="flex items-center justify-between gap-3">
        <span class="text-[0.9375rem] font-semibold text-strong">
          {app.certificates}
        </span>
        <span class="rounded-md border border-border px-2.5 py-1 text-[0.6875rem] text-foreground">
          {app.connect}
        </span>
      </div>
      <div class="mt-5 space-y-2">
        <div class:list={[skeleton, "h-10"]} />
        <div class:list={[skeleton, "h-10"]} />
        <div class:list={[skeleton, "h-10 w-2/3"]} />
      </div>
    </div>
    <div class={backdrop}>
      <div class:list={[dialog, "max-w-md"]}>
        <div class="border-b border-border px-4 py-3">
          <p class="text-[0.875rem] font-semibold text-strong">
            {app.commandTitle}
          </p>
          <p class="mt-1 text-[0.6875rem] leading-relaxed text-muted-foreground">
            {app.commandDescription}
          </p>
        </div>
        <div class="space-y-3 px-4 py-3">
          <div class="grid w-40 grid-cols-2 rounded-md border border-border p-0.5 text-center text-[0.6875rem]">
            <span class="rounded-sm bg-accent py-0.5 font-medium text-strong">
              Linux
            </span>
            <span class="py-0.5 text-muted-foreground">Windows</span>
          </div>
          <div class="flex items-start gap-2">
            <code class="min-w-0 flex-1 rounded-md border border-border bg-muted/40 px-2.5 py-2 text-[0.6875rem] leading-relaxed break-all text-foreground">
              {command}
            </code>
            <span class="grid size-7 shrink-0 place-items-center rounded-md border border-border text-muted-foreground">
              <Copy class="size-3.5" stroke-width={1.75} />
            </span>
          </div>
          <p class="flex flex-wrap gap-x-3 text-[0.6875rem] text-muted-foreground">
            <span>
              {app.code}{" "}
              <span class="font-mono text-foreground">7KQ4-XMPA</span>
            </span>
            <span class="tabular-nums">{app.expiresIn}</span>
          </p>
          <p class="flex items-center gap-2 text-[0.6875rem] text-muted-foreground">
            <LoaderCircle class="size-3.5 animate-spin motion-reduce:animate-none" />
            {app.waiting}
          </p>
          <p class="flex gap-2 border-t border-border pt-3 text-[0.625rem] leading-relaxed text-muted-foreground">
            <ShieldAlert class="mt-0.5 size-3 shrink-0" />
            {app.requirements}
          </p>
        </div>
        <div class="flex justify-end border-t border-border px-4 py-2.5">
          <span class={primaryButton}>{app.done}</span>
        </div>
      </div>
    </div>
  </MockWindow>
)}

{scene === "install" && (
  <div class="terminal-frame shadow-[0_18px_40px_-24px_rgb(0_0_0/0.35)]">
    <div class="terminal-bar h-8 gap-2 px-3 font-mono text-[0.6875rem] text-terminal-muted">
      <span class="size-1.5 rounded-full bg-primary" />
      {mock.terminal.prompt}
    </div>
    <div class="space-y-0.5 px-4 py-3.5 font-mono text-[0.75rem] leading-relaxed text-terminal-fg">
      <p class="break-all">
        <span class="text-primary">$</span> {command}
      </p>
      {mock.terminal.lines.map((line) => (
        <p
          class:list={[
            line.tone === "muted" && "text-terminal-muted",
            line.tone === "gap" && "h-3",
            line.tone === "check" && "pl-4",
          ]}
        >
          {line.tone === "check" && <span class="text-primary">✓ </span>}
          {line.text}
        </p>
      ))}
    </div>
  </div>
)}

{(scene === "unlock" || scene === "choose") && (
  <MockWindow kind="site" address={mock.site}>
    <div class:list={[layer, "p-5"]}>
      <div class:list={[skeleton, "h-3 w-28"]} />
      <div class:list={[skeleton, "mt-4 h-5 w-3/4"]} />
      <div class:list={[skeleton, "mt-2 h-3 w-1/2"]} />
      <div class="mt-6 inline-flex rounded-md border border-border px-3 py-1.5 text-[0.75rem] text-foreground">
        {mock.siteButton}
      </div>
      <div class="mt-8 grid grid-cols-3 gap-2">
        <div class:list={[skeleton, "h-14"]} />
        <div class:list={[skeleton, "h-14"]} />
        <div class:list={[skeleton, "h-14"]} />
      </div>
    </div>
    <div class={backdrop}>
      {scene === "unlock" ? (
        <div class:list={[dialog, "max-w-sm p-4"]}>
          <p class="text-[0.875rem] font-semibold text-strong">
            {mock.passwordTitle}
          </p>
          <p class="mt-2 text-[0.75rem] leading-relaxed text-foreground">
            {mock.passwordText}
          </p>
          <div class="mt-3 flex items-center rounded-md border border-primary px-2.5 py-1.5 ring-[3px] ring-primary/20">
            <span class="font-mono text-[0.8125rem] tracking-[0.3em] text-strong">
              ••••••
            </span>
            <span class="h-3.5 w-px animate-pulse bg-strong motion-reduce:animate-none" />
          </div>
          <div class="mt-4 flex justify-end gap-2">
            <span class={dialogButton}>{mock.cancel}</span>
            <span class={primaryButton}>{mock.ok}</span>
          </div>
        </div>
      ) : (
        <div class:list={[dialog, "max-w-md p-4"]}>
          <p class="text-[0.875rem] font-semibold text-strong">
            {mock.chooserTitle}
          </p>
          <p class="mt-2 text-[0.75rem] leading-relaxed text-foreground">
            {mock.chooserText}
          </p>
          <ul class="mt-3 overflow-hidden rounded-md border border-border text-[0.75rem]">
            {mock.certificates.map((certificate, index) => (
              <li
                class:list={[
                  "flex items-start gap-2.5 px-3 py-2",
                  index === 0 && "bg-accent",
                  index > 0 && "border-t border-border",
                ]}
              >
                <span
                  class:list={[
                    "mt-1 grid size-3 shrink-0 place-items-center rounded-full border",
                    index === 0 && "border-primary",
                    index > 0 && "border-border",
                  ]}
                >
                  {index === 0 && (
                    <span class="size-1.5 rounded-full bg-primary" />
                  )}
                </span>
                <span class="min-w-0">
                  <span
                    class:list={[
                      "block",
                      index === 0 && "font-medium text-strong",
                      index > 0 && "text-foreground",
                    ]}
                  >
                    {certificate.name}
                  </span>
                  <span class="block text-[0.6875rem] text-muted-foreground">
                    Garabato · {certificate.valid}
                  </span>
                </span>
              </li>
            ))}
          </ul>
          <div class="mt-4 flex justify-end gap-2">
            <span class={dialogButton}>{mock.cancel}</span>
            <span class={primaryButton}>{mock.ok}</span>
          </div>
        </div>
      )}
    </div>
  </MockWindow>
)}

{scene === "unlock" && (
  <div class="mt-3 flex w-fit items-center gap-3 rounded-frame border border-border bg-background px-3.5 py-2.5 shadow-[0_18px_40px_-24px_rgb(0_0_0/0.35)] sm:absolute sm:right-4 sm:bottom-4 sm:mt-0">
    <KeyRound class="size-4 shrink-0 text-primary" stroke-width={1.75} />
    <span>
      <span class="block text-[0.6875rem] text-muted-foreground">
        {mock.authenticator}
      </span>
      <span class="block font-mono text-[1.0625rem] font-medium tracking-[0.12em] text-strong tabular-nums">
        482 913
      </span>
    </span>
  </div>
)}

{scene === "trace" && (
  <MockWindow kind="app" address="/traces">
    <div class="p-5">
      <span class="text-[0.9375rem] font-semibold text-strong">
        {app.traces}
      </span>
      <ol class="mt-4 text-[0.75rem]">
        {app.traceRows.map((row, index) => (
          <li
            class:list={[
              "grid grid-cols-[0.75rem_1fr_auto] items-baseline gap-x-2.5 border-t border-hairline px-2 py-2.5",
              index === 0 && "rounded-md border-transparent bg-accent",
            ]}
          >
            <span
              class:list={[
                "size-2 rounded-full",
                index === 0 && "bg-primary",
                index > 0 && "bg-border",
              ]}
            />
            <span class="min-w-0">
              <span class="block font-medium text-strong">{row.action}</span>
              <span class="block truncate text-[0.6875rem] text-muted-foreground">
                {row.detail}
              </span>
            </span>
            <span class="text-[0.6875rem] whitespace-nowrap text-muted-foreground">
              {row.when}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </MockWindow>
)}
