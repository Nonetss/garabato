---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!-- The app's mark (apps/frontend/src/assets/logo.svg), in currentColor. -->
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M3 15c3 0 6.5-1.5 8.5-5s1.5-6.5-.5-6.5S7.5 8 8.5 12s2.5 4.5 4 4.5 2-2.5 3.5-2.5 1.5 2 3 2 1.5-.5 2-1"
  ></path>
  <path d="M3 21h18"></path>
</svg>
