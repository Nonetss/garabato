---
import { ProfilePage } from "@/features/profile"
import Layout from "@/layouts/Layout.astro"
import { appSurfaces } from "@/lib/app-surfaces"

const { user, session } = Astro.locals

if (!user || !session) return Astro.redirect("/login")
---

<Layout title={appSurfaces.profile.title}>
  <ProfilePage user={user} session={session} client:only="react" />
</Layout>
