---
import { getIcon } from "@/lib/icon-registry"

const ArrowLeft = getIcon("navigation", "back")

import Layout from "@/layouts/Layout.astro"
import { appSurfaces } from "@/lib/app-surfaces"
---

<Layout title={appSurfaces["not-found"].title}>
  <main
    class="mx-auto flex min-h-main w-full max-w-3xl flex-col justify-center px-4 py-24 sm:px-6"
  >
    <h1
      class="font-semibold text-display leading-(--line-height-display) tracking-tight"
    >
      Esta página no existe
    </h1>
    <p class="mt-2 max-w-prose text-meta text-muted-foreground leading-relaxed">
      Error 404. El enlace que has seguido está roto o el contenido se ha
      movido.
    </p>
    <a
      href="/"
      class="mt-8 -ml-1 inline-flex w-fit items-center gap-1 text-muted-foreground text-status uppercase tracking-(--tracking-eyebrow) transition-colors hover:text-foreground"
    >
      <ArrowLeft className="size-3" aria-hidden="true" />
      Volver al inicio
    </a>
  </main>
</Layout>
