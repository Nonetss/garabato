# Gateway: the only place that maps requests to the app that serves them.
#
# :{$GATEWAY_HTTP_PORT} (default 80) is the public entry point and the only
# port compose publishes. It serves the backend's HTTP API and the frontend on
# one origin, so the browser never makes cross-origin calls. The site's body
# lives in routes.caddy, shared with the dev gateway (Caddyfile.dev).
{
	admin off
	auto_https off
	servers {
		protocols h1 h2c
	}
}

:{$GATEWAY_HTTP_PORT:80} {
	import routes.caddy
}
