# Gateway: the only place that maps requests to the app that serves them.
#
# :{$GATEWAY_HTTP_PORT} (default 80) is the public entry point and the only
# port compose publishes. It serves the backend's HTTP API and the frontend on
# one origin, so the browser never makes cross-origin calls.
{
	admin off
	auto_https off
	servers {
		protocols h1 h2c
	}
}

:{$GATEWAY_HTTP_PORT:80} {
	encode zstd gzip

	# Liveness of the gateway itself, for the compose healthcheck
	handle /health {
		respond "ok" 200
	}

	@backend path /rpc/* /api/* /scalar* /openapi.json
	handle @backend {
		reverse_proxy {$BACKEND_HTTP_UPSTREAM:backend:3000}
	}

	handle {
		reverse_proxy {$FRONTEND_HTTP_UPSTREAM:frontend:4321}
	}
}
